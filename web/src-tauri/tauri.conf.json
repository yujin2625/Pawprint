{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pawprint",
  "version": "0.1.0",
  "identifier": "io.github.yujin2625.pawprint",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pawprint",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "yujin2625",
    "homepage": "https://github.com/yujin2625/Pawprint",
    "shortDescription": "Pawprint blueprint editor",
    "copyright": "PolyForm Noncommercial 1.0.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pawprint"],
        "name": "Pawprint blueprint",
        "description": "Pawprint blueprint",
        "role": "Editor",
        "mimeType": "application/x-pawprint"
      },
      {
        "ext": ["pawpack"],
        "name": "Pawprint block pack",
        "description": "Pawprint block pack",
        "role": "Viewer",
        "mimeType": "application/x-pawpack"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
